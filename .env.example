# Polymarket API credentials (production)
# Obtain from https://polymarket.com/settings/api
export POLYMARKET_API_KEY=your_api_key_here
export POLYMARKET_API_SECRET=your_api_secret_here
export POLYMARKET_WALLET_ADDRESS=0xYourWalletAddressHere

# Optional: if signing locally (advanced)
export POLYMARKET_PRIVATE_KEY=your_private_key_here

# Telegram for alerts (already set in ~/.hermes/.env)
export TELEGRAM_BOT_TOKEN=your_telegram_bot_token
export TELEGRAM_CHAT_ID=your_chat_id_or_group_id

# Server timezone
export TZ=Europe/Bratislava
